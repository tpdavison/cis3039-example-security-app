# Public build-time settings only; never put host keys or client secrets here.
# Base URL for your products API; /products is appended to this path.
# Deployed: https://YOUR_ACTUAL_TEST_HOSTNAME/api (discover it using Azure CLI).
# In development .env.local is git-ignored.
VITE_API_BASE_URL=http://localhost:7071/api

# Reuse the shared backend Auth0 setup: one tenant, Products API and SPA.
VITE_AUTH0_DOMAIN=YOUR_ACTUAL_AUTH0_DOMAIN
VITE_AUTH0_CLIENT_ID=YOUR_SPA_CLIENT_ID
# Required API identifier/audience, distinct from the backend HTTP URL.
VITE_AUTH0_AUDIENCE=YOUR_PRODUCTS_API_IDENTIFIER
